{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "types": [],
    "esModuleInterop": true,
    "noImplicitReturns": false,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "lib",
    "declaration": true,
    "jsx": "react-jsx"
  },
  "files": [
    "src/index.ts",
    "src/native/index.ts",
    "src/core/index.ts",
    "src/react/index.ts",
    "src/grid/index.ts",
    "src/windows/index.ts",
    "src/logs/index.ts",
    "src/communication/index.ts",
    "src/stand/demo/peerMedia.tsx",
    "src/stand/demo/peerConference.tsx"
  ]
}
