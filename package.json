{
  "name": "wenay-react2",
  "version": "1.0.65",
  "description": "Common react",
  "strict": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "testjest": "jest",
    "testjest2": "jest --clearCache",
    "update": "pnpm update --latest",
    "typecheck": "tsc -p tsconfig.qa-check.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build & watch": "npm run _clearDir  &&  tsc --watch",
    "build": "npm run _clearDir  &&  tsc --build --verbose  &&  npm run _afterBuild  && npm run _copyStyle",
    "pack": "npm run build  &&  npm pack .\\dist",
    "testReact": "vite",
    "_publish": "npm publish .\\dist",
    "_afterBuild": "node copyCompiledFiles.mjs .\\dist  &&  cd dist  &&  npm pkg delete scripts devDependencies private",
    "_copyStyle": "xcopy /Y /S \".\\src\\style\\*.*\" \".\\dist\\lib\\style\\\"\n",
    "publish": "npm run _afterBuild && npm run _copyStyle &&  npm run _publish",
    "build & publish": "npm run build  &&  npm run _publish",
    "_clearDir": "IF exist lib (rd /s /q lib)  &&  mkdir lib  &&  copy tsconfig_lib.json lib\\tsconfig.json  &&  echo:"
  },
  "files": [
    "lib/**/*",
    "doc/**/*",
    "!**/*.tsbuildinfo"
  ],
  "author": "wenay",
  "license": "ISC",
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "ag-grid-community": "^36.0.2",
    "ag-grid-react": "^36.0.2",
    "re-resizable": "^6.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-rnd": "^10.5.3",
    "wenay-common2": "^2.0.1"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "path-browserify": "^1.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=18",
    "vscode": "^1.22.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead"
    ],
    "development": [
      ">1%"
    ]
  },
  "exports": {
    ".": "./lib/index.js",
    "./lib/common/api.js": "./lib/common/api.js",
    "./native": "./lib/native/index.js",
    "./package.json": "./package.json",
    "./communication": "./lib/common/src/components/Communication/index.js",
    "./demo/peer-media": "./lib/common/demo/peerMedia.js",
    "./demo/peer-conference": "./lib/common/demo/peerConference.js",
    "./demo/stand": "./lib/common/testUseReact/qa.js"
  }
}
