{
  "name": "wenay-react2",
  "version": "3.1.0",
  "description": "Common react",
  "type": "module",
  "strict": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "testjest": "jest",
    "test": "jest --runInBand",
    "testjest2": "jest --clearCache",
    "update": "pnpm update --latest",
    "typecheck": "tsc -p tsconfig.qa-check.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build & watch": "npm run _clearDir  &&  npm run _copyTypeSupport  &&  tsc --watch",
    "build": "npm run _clearDir  &&  tsc --build --verbose  &&  npm run _copyTypeSupport  &&  npm run _checkGeneratedTypes  &&  npm run _afterBuild  && npm run _copyStyle  &&  npm run package:probe  &&  npm run package:consumer",
    "types:generate": "tsc -p tsconfig.json --emitDeclarationOnly  &&  npm run _copyTypeSupport  &&  npm run _checkGeneratedTypes",
    "types:watch": "npm run _copyTypeSupport  &&  tsc -p tsconfig.json --emitDeclarationOnly --watch",
    "types:check": "npm run _copyTypeSupport  &&  npm run _checkGeneratedTypes",
    "bundle:probe": "node scripts/ag-grid-bundle-probe.mjs",
    "package:probe": "node scripts/package-entrypoint-probe.mjs",
    "package:consumer": "node scripts/packed-consumer-probe.mjs",
    "pack": "npm run build  &&  npm pack .\\dist",
    "testReact": "vite",
    "_publish": "npm publish .\\dist",
    "_afterBuild": "node copyCompiledFiles.mjs .\\dist  &&  cd dist  &&  npm pkg delete scripts devDependencies private",
    "_copyTypeSupport": "node copyTypeSupport.mjs",
    "_checkGeneratedTypes": "tsc --ignoreConfig --noEmit --target ESNext --module ESNext --moduleResolution Bundler --jsx react-jsx --strict --skipLibCheck false lib/index.d.ts lib/native/index.d.ts lib/core/index.d.ts lib/react/index.d.ts lib/grid/index.d.ts lib/windows/index.d.ts lib/logs/index.d.ts lib/communication/index.d.ts lib/persist/index.d.ts lib/params/index.d.ts lib/modal/index.d.ts lib/menu/index.d.ts lib/chart/index.d.ts lib/ui/index.d.ts",
    "_copyStyle": "xcopy /Y /S \".\\src\\style\\*.*\" \".\\dist\\lib\\style\\\"\n",
    "publish": "npm run _afterBuild && npm run _copyStyle &&  npm run _publish",
    "build & publish": "npm run build  &&  npm run _publish",
    "_clearDir": "IF exist lib (rd /s /q lib)  &&  mkdir lib  &&  echo:"
  },
  "files": [
    "lib/**/*",
    "doc/**/*",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "author": "wenay",
  "license": "ISC",
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "re-resizable": "^6.11.2",
    "react-rnd": "^10.5.3",
    "wenay-common2": "^2.16.0"
  },
  "peerDependencies": {
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wenay-common2": "^2.16.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "path-browserify": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead"
    ],
    "development": [
      ">1%"
    ]
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js",
      "default": "./lib/core/index.js"
    },
    "./react": {
      "types": "./lib/react/index.d.ts",
      "import": "./lib/react/index.js",
      "default": "./lib/react/index.js"
    },
    "./grid": {
      "types": "./lib/grid/index.d.ts",
      "import": "./lib/grid/index.js",
      "default": "./lib/grid/index.js"
    },
    "./windows": {
      "types": "./lib/windows/index.d.ts",
      "import": "./lib/windows/index.js",
      "default": "./lib/windows/index.js"
    },
    "./logs": {
      "types": "./lib/logs/index.d.ts",
      "import": "./lib/logs/index.js",
      "default": "./lib/logs/index.js"
    },
    "./persist": {
      "types": "./lib/persist/index.d.ts",
      "import": "./lib/persist/index.js",
      "default": "./lib/persist/index.js"
    },
    "./native": {
      "types": "./lib/native/index.d.ts",
      "import": "./lib/native/index.js",
      "default": "./lib/native/index.js"
    },
    "./package.json": "./package.json",
    "./styles": "./lib/style/style.css",
    "./styles/tokens": "./lib/style/tokens.css",
    "./styles/menu-right": "./lib/style/menuRight.css",
    "./styles/communication": "./lib/style/communication.css",
    "./communication": {
      "types": "./lib/communication/index.d.ts",
      "import": "./lib/communication/index.js",
      "default": "./lib/communication/index.js"
    },
    "./params": {
      "types": "./lib/params/index.d.ts",
      "import": "./lib/params/index.js",
      "default": "./lib/params/index.js"
    },
    "./modal": {
      "types": "./lib/modal/index.d.ts",
      "import": "./lib/modal/index.js",
      "default": "./lib/modal/index.js"
    },
    "./menu": {
      "types": "./lib/menu/index.d.ts",
      "import": "./lib/menu/index.js",
      "default": "./lib/menu/index.js"
    },
    "./chart": {
      "types": "./lib/chart/index.d.ts",
      "import": "./lib/chart/index.js",
      "default": "./lib/chart/index.js"
    },
    "./ui": {
      "types": "./lib/ui/index.d.ts",
      "import": "./lib/ui/index.js",
      "default": "./lib/ui/index.js"
    },
    "./demo/peer-media": {
      "types": "./lib/stand/demo/peerMedia.d.ts",
      "import": "./lib/stand/demo/peerMedia.js",
      "default": "./lib/stand/demo/peerMedia.js"
    },
    "./demo/peer-conference": {
      "types": "./lib/stand/demo/peerConference.d.ts",
      "import": "./lib/stand/demo/peerConference.js",
      "default": "./lib/stand/demo/peerConference.js"
    }
  }
}
